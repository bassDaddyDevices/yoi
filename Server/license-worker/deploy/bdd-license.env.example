# Copy to /etc/bdd-license.env on the VPS, then: sudo chmod 600 /etc/bdd-license.env
# PRODUCTS holds YOI's Gumroad product_id (not secret). LICENSE_PRIVATE_KEY is filled in by
# scripts/make-keys.mjs --env-file; leave it empty until then.
# Never commit the filled-in copy.
PORT=8787
HOST=127.0.0.1
PRODUCTS={"YOI":{"gumroadProductId":"Opo8b_oq_j-dAJHEX-zCIg==","major":1,"maxActivations":5}}
# From `npm run make-keys` (the PRIVATE key line). Keep a backup in a password manager.
LICENSE_PRIVATE_KEY=
